+def read(root: Path, relative: str | Path) -> bytes:
+    path = root / relative
+    need(path.is_file(), "missing checkpoint input: " + str(relative))
+    need(not any(item.is_symlink() for item in (path, *path.parents)), "symlink input")
+    return path.read_bytes()
