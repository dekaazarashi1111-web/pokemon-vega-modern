+static void m_open_form_row(struct mCore *c,unsigned page,unsigned cursor,
+    const char *prefix,unsigned round){
+    a_require(page<M_MAX_PAGES && cursor<M_ROWS_PER_PAGE,
+        "generic form reopen target outside bounded menu");
+    b_position(c,1U,36U,6U,4U);
+    unsigned object=read8(c,P02S_PLAYER_AVATAR+5U);
+    a_require(object<16U,"generic form reopen avatar unavailable");
+    if((read8(c,P02S_OBJECT_EVENTS+object*0x24U+0x18U)&15U)!=2U)b_frame(c,QOL_KEY_UP);
+    b_frames_run(c,0U,30U);b_position(c,1U,36U,6U,4U);
+    b_press(c,QOL_KEY_A,90U);
+    m_waitmenu(c,0U,0U,prefix,round,"probe-reopen-root-timeout");
+    a_require(read8(c,M_CURSOR)==0U,"generic form reopen root cursor differs");
+    b_press(c,QOL_KEY_DOWN,30U);
+    a_require(read8(c,M_CURSOR)==1U,"generic form reopen service cursor differs");
+    b_press(c,QOL_KEY_A,60U);
+    m_waitmenu(c,2U,0U,prefix,round,"probe-reopen-forms-timeout");
+    for(unsigned current=0U;current<page;++current){
+        a_require(m_menu(c,2U,current) && read8(c,M_CURSOR)==0U,
+            "generic form reopen page precondition differs");
+        for(unsigned row=0U;row<M_ROWS_PER_PAGE;++row)b_press(c,QOL_KEY_DOWN,30U);
+        a_require(read8(c,M_CURSOR)==M_ROWS_PER_PAGE,
+            "generic form reopen next-page cursor differs");
+        b_press(c,QOL_KEY_A,60U);
+        m_waitmenu(c,2U,current+1U,prefix,round,"probe-reopen-page-timeout");
+    }
+    a_require(m_menu(c,2U,page) && read8(c,M_CURSOR)==0U,
+        "generic form reopen target page differs");
+    for(unsigned row=0U;row<cursor;++row)b_press(c,QOL_KEY_DOWN,30U);
+    a_require(read8(c,M_CURSOR)==cursor,"generic form reopen target cursor differs");
+}
