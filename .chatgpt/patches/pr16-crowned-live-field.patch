+/* A native win / item exchange may start a Quest Log RECORDING scene.
+ * Reuse the already-audited live (1,2) enum pair; never clear it by host.
+ * Playback, field locks, moving/inactive avatars and non-field callbacks
+ * remain rejected. The final ordinary Save must cut the recording itself. */
+static void f_live_step(struct mCore *core, unsigned key)
+{
+    a_require(f_live_field(core), "fixed acceptance step outside live field");
+    unsigned save1 = b_save1(core);
+    unsigned x = read16(core, save1), y = read16(core, save1 + 2U);
+    bool moved = false;
+    for (unsigned frame = 0U; frame < 90U; ++frame) {
+        b_frame(core, key);
+        save1 = b_save1(core);
+        if (read16(core, save1) != x || read16(core, save1 + 2U) != y) {
+            moved = true;
+            break;
+        }
+    }
+    core->setKeys(core, 0U);
+    a_require(moved, "fixed acceptance live grass pair blocked");
+    ++n_steps;
+    unsigned stable = 0U;
+    for (unsigned frame = 0U; frame < 12000U; ++frame) {
+        if (read32(core, ADDR_NEW_BATTLE_STRUCT_POINTER)) {
+            n_wait_action(core);
+            return;
+        }
+        if (f_live_field(core)) {
+            if (++stable == 12U)
+                return;
+        } else {
+            stable = 0U;
+        }
+        b_frame(core, 0U);
+    }
+    k_state(core, "live-walk-timeout");
+    f_shot(core, "live-walk-timeout");
+    a_die("fixed acceptance live step neither settled nor entered battle");
+}
+
+static void f_return_live_field(struct mCore *core)
+{
+    unsigned stable = 0U;
+    for (unsigned frame = 0U; frame < 24000U; ++frame) {
+        unsigned outcome = read8(core, BATTLE_CORE_BATTLE_OUTCOME);
+        if (!read32(core, ADDR_NEW_BATTLE_STRUCT_POINTER)
+            && f_live_field(core)) {
+            a_require(outcome == BATTLE_CORE_OUTCOME_WON || outcome == 4U,
+                      "fixed acceptance unexpected battle exit outcome");
+            if (++stable == 30U) {
+                core->setKeys(core, 0U);
+                k_state(core, "native-live-field-restored");
+                return;
+            }
+        } else {
+            stable = 0U;
+        }
+        if (n_action(core)) {
+            n_cursor(core, 3U);
+            b_press(core, QOL_KEY_A, 60U);
+        } else {
+            b_frame(core, frame % 60U == 0U ? QOL_KEY_B : 0U);
+        }
+    }
+    k_state(core, "live-return-timeout");
+    f_shot(core, "live-return-timeout");
+    a_die("fixed acceptance battle did not return to native live field");
+}
+
+static void f_open_live_bag(struct mCore *core)
+{
+    a_require(f_live_field(core), "fixed acceptance Bag outside live field");
+    b_press(core, QOL_KEY_START, 120U);
+    a_require(read32(core, QOL_START_MENU_CALLBACK) == QOL_START_MENU_INPUT,
+              "fixed acceptance real Start menu absent");
+    unsigned count = read8(core, QOL_START_MENU_COUNT);
+    unsigned at = read8(core, QOL_START_MENU_CURSOR), target = count;
+    a_require(count && count <= 9U && at < count,
+              "fixed acceptance invalid Start menu");
+    for (unsigned index = 0U; index < count; ++index) {
+        if (read8(core, QOL_START_MENU_ORDER + index) == 2U)
+            target = index;
+    }
+    a_require(target < count, "fixed acceptance Start menu lacks Bag");
+    for (unsigned index = 0U, total = (target + count - at) % count;
+         index < total; ++index)
+        b_press(core, QOL_KEY_DOWN, 30U);
+    a_require(read8(core, QOL_START_MENU_CURSOR) == target,
+              "fixed acceptance Bag cursor did not follow native input");
+    b_press(core, QOL_KEY_A, 180U);
+}
