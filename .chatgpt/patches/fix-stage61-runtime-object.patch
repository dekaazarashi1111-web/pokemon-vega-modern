+    def test_gift_root_088b3190_player_movement_operand_and_resolution(self) -> None:
+        from tools.stage61_interaction_oracle import (
+            _runner_effect_rows, _runner_map_object_templates,
+        )
+
+        executions, blockers, graph = self._run_root(0x088B3190)
+        self.assertEqual(blockers, [])
+        self.assertTrue(any(
+            instruction.raw[0] in {0x4F, 0x50}
+            and int.from_bytes(instruction.raw[1:3], "little") == 0xFF
+            for node in graph.nodes.values() for instruction in node.instructions
+        ))
+        player_contexts = [
+            context for context, state in executions
+            if any(
+                row.get("domain") == "objects"
+                and row.get("relation") == "APPLY_ORDERED_MOVEMENT"
+                and row.get("owner") == "LOCAL_OBJECT:255"
+                for row in _runner_effect_rows(state, None)
+            )
+        ]
+        self.assertTrue(player_contexts)
+        for context in player_contexts:
+            self.assertNotEqual(context.npc["local_id"], 0xFF)
+            interaction = context.case["interaction"]
+            templates = _runner_map_object_templates(
+                context, interaction["group"], interaction["map"],
+            )
+            self.assertNotIn(0xFF, {row[0] for row in templates})
+
