+    def test_ordered_movement_requires_active_local_object_not_template(self) -> None:
+        from tools.stage61_interaction_oracle import _runner_object_postconditions
+        import struct
+
+        context = self._context(case={"interaction": {"group": 1, "map": 2}})
+        template = bytearray(0x18)
+        template[0] = 7
+        struct.pack_into("<hh", template, 4, 2, 3)
+        struct.pack_into("<H", template, 0x14, 0x200)
+        effect = {
+            "domain": "objects", "owner": "LOCAL_OBJECT:7",
+            "relation": "APPLY_ORDERED_MOVEMENT", "target_map": None,
+            "movement": {"actions": [0x08]},
+        }
+        with patch(
+            "tools.stage61_interaction_oracle._runner_map_object_templates",
+            return_value=[template],
+        ):
+            self.assertEqual(_runner_object_postconditions(context, [effect]), [{
+                "local_id": 7, "after": {
+                    "map": "1/2", "invisible": False, "visible": True,
+                    "current": [9, 11], "previous": [9, 10],
+                },
+            }])
+            context.case["state"]["flags"] = [{"id": 0x200, "value": True}]
+            self.assertEqual(_runner_object_postconditions(context, [effect]), [])
+        context.case["state"]["flags"] = []
+        with patch(
+            "tools.stage61_interaction_oracle._runner_map_object_templates",
+            return_value=[],
+        ):
+            self.assertEqual(_runner_object_postconditions(context, [effect]), [])
+            player = {**effect, "owner": "LOCAL_OBJECT:255"}
+            with self.assertRaisesRegex(
+                Stage61InteractionOracleError, "active runtime object欠落:255",
+            ):
+                _runner_object_postconditions(context, [player])
+
