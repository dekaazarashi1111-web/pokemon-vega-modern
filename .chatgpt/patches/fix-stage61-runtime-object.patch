+    @classmethod
+    def _owner_with_catalog_player_position(cls, owner: dict) -> dict:
+        """Bind catalog input geometry only after checking the current object."""
+        rows = [row for row in cls.catalog["npcs"]
+                if row["npc_id"] == owner["owner_id"]]
+        if len(rows) != 1:
+            raise AssertionError("gift player fixture catalog owner is not unique")
+        npc = rows[0]
+        offset = owner["record_address"] - 0x08000000
+        raw = cls.stage61[offset:offset + 0x18] if offset >= 0 else b""
+        if len(raw) != 0x18 or (
+            npc["group"], npc["map"], npc["object_index"],
+            npc["script_pointer"], npc["local_id"], npc["flag"],
+        ) != (
+            owner["group"], owner["map"], owner["index"],
+            owner["root"], raw[0], int.from_bytes(raw[0x14:0x16], "little"),
+        ) or int.from_bytes(raw[0x10:0x14], "little") != owner["root"]:
+            raise AssertionError("gift player fixture current object identity differs")
+        execution = npc.get("interaction_execution")
+        if not isinstance(execution, dict):
+            raise AssertionError("gift player fixture interaction execution is missing")
+        stance = execution.get("stance")
+        target = npc.get("interaction_object")
+        distance = execution.get("interaction_distance")
+        # The catalog and _runtime_object_player_position_fixture use action,
+        # not facing. Do not accept a guessed key or silently invent a stance.
+        action = execution.get("action")
+        deltas = {"UP": (0, -1), "DOWN": (0, 1),
+                  "LEFT": (-1, 0), "RIGHT": (1, 0)}
+        basis = npc.get("interaction_object_basis")
+        if (not isinstance(stance, list) or len(stance) != 2
+                or not isinstance(target, list) or len(target) != 2
+                or any(isinstance(value, bool) or not isinstance(value, int)
+                       or not 0 <= value <= 0xFFFF for value in stance + target)
+                or isinstance(distance, bool) or not isinstance(distance, int)
+                or distance not in {1, 2} or not isinstance(action, str)
+                or action not in deltas or not isinstance(basis, str) or not basis):
+            raise AssertionError("gift player fixture catalog stance is invalid")
+        if basis == "FINAL_OBJECT_TEMPLATE" and target != [
+            int.from_bytes(raw[4:6], "little", signed=True),
+            int.from_bytes(raw[6:8], "little", signed=True),
+        ]:
+            raise AssertionError("gift player fixture template target differs")
+        dx, dy = deltas[action]
+        if [stance[0] + dx * distance, stance[1] + dy * distance] != target:
+            raise AssertionError("gift player fixture does not face its source object")
+        bound = deepcopy(owner)
+        bound["interaction_object"] = {"x": target[0], "y": target[1]}
+        bound["interaction_distance"] = distance
+        bound["interaction_object_basis"] = basis
+        bound["interaction_execution"] = deepcopy(execution)
+        bound["physical_player_position"] = {
+            "group": owner["group"], "map": owner["map"],
+            "x": stance[0], "y": stance[1],
+        }
+        return bound
+
